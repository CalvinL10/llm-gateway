{
  "name": "@llm-gateway/dsh-subscriptions",
  "version": "0.3.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Subscription connections and independent child model defaults for ordinary DSH conversations",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./defaults": "./lib/defaults.js", "./package.json": "./package.json" },
  "engines": { "dsh": "0.2.1-rc.3", "node": ">=22.19.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-connection"] }
  },
  "files": ["lib/", "cordis.patch.yml", "README.md", "THIRD_PARTY_NOTICES.md", "UPSTREAM_LICENSE"],
  "scripts": { "build": "node build.mjs", "test": "node --test test/*.test.mjs" },
  "dependencies": { "undici": "8.10.0", "zod": "4.4.3" },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/schemastery": "~3.18.5", "@deepseek-ai/dsh-llm": "0.2.1-rc.3", "@deepseek-ai/dsh-timeout": "0.2.1-rc.3", "@deepseek-ai/dsh-settings": "0.2.1-rc.3", "react": "^18.3.1" },
  "devDependencies": { "esbuild": "0.25.12" }
}
